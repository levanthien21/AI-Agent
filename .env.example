# Lấy API key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Mật khẩu để vào trang quản trị (/admin) và nạp kiến thức
ADMIN_KEY=doi-mat-khau-nay

# Thông tin Firebase (chuỗi base64 của file service-account.json)
# Cách lấy: Tải file JSON service account từ Firebase -> dùng công cụ Base64 encode file đó thành 1 chuỗi dài rồi dán vào đây.
FIREBASE_BASE64=ey...

# (tuỳ chọn)
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
# Website được phép nhúng widget, "*" = tất cả. Ví dụ: https://shop.com,https://www.shop.com
ALLOWED_ORIGINS=*
